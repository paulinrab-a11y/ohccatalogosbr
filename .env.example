# Browser/public Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secrets (Vercel / local server only; never expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OHC_EDGE_TOKEN=GENERATE_A_RANDOM_64_HEX_SECRET
OHC_RATE_LIMIT_SECRET=GENERATE_A_RANDOM_64_HEX_SECRET

# Administrative access / origins
# Optional extra allowlist layered on top of app_metadata.role=ohc_admin.
# Keep explicit in production if you want this additional restriction.
OHC_ADMIN_EMAILS=admin@example.com
OHC_PUBLIC_ORIGIN=https://www.ohcmotorsbr.com.br
OHC_ALLOWED_ORIGINS=https://ohcmotorsbr.com.br

# Optional client observability
VITE_SENTRY_DSN=

# Customer Auth: public values returned by /api/customer-config, never service_role.
# Production may reuse SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY/ANON_KEY above.
# Preview REQUIRES a separate development project; production fallback is blocked.
OHC_CUSTOMER_SUPABASE_URL=
OHC_CUSTOMER_PUBLISHABLE_KEY=
