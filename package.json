    "gsap": "^3.12.5",
    "lenis": "^1.3.4",
    "motion": "^12.4.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "0.5.8",
