mn_name":"tipo_cubo_adaptador","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"observacoes_airbag_comandos","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"formato_aro","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"protocolo","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"shift_light","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"compatibilidade_atual_catalogo","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"status_compatibilidade","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"resultado_externo","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"fonte_arquivo","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"ultima_revisao","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"BASE DE DADOS DOS VOLANTES","column_name":"responsavel","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_request_photos","column_name":"object_path","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_request_photos","column_name":"original_name","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_request_photos","column_name":"content_type","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"product_sku","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"product_sku_key","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"vehicle_brand","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"vehicle_brand_key","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"vehicle_model","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"vehicle_model_key","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"generation_chassis","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"generation_key","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"vehicle_version","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"version_key","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"status","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"admin_notes","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"reviewed_by","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"rule_scope","data_type":"text","udt_name":"text","is_nullable":"NO"},{"table_name":"compatibility_rules","column_name":"public_notes","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"internal_notes","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"installation_conditions","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"compatibility_rules","column_name":"confirmed_by","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"catalog_products","column_name":"sku","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"catalog_products","column_name":"slug","data_type":"text","udt_name":"text","is_nullable":"YES"},{"table_name":"catalog_products","column_name":"categoria","data_type":"text","udt_name":"text","is_nullable":"YES"}],"policies":[{"schemaname":"public","tablename":"BASE DE DADOS DOS VOLANTES","policyname":"public_read_approved_products","roles":["anon","authenticated"],"cmd":"SELECT","qual":"((ativo IS TRUE) AND (publicado IS TRUE) AND (aprovado_administrador IS TRUE))","with_check":null},{"schemaname":"public","tablename":"compatibility_request_photos","policyname":"block_direct_photo_metadata_access","roles":["anon","authenticated"],"cmd":"ALL","qual":"false","with_check":"false"},{"schemaname":"public","tablename":"compatibility_rules","policyname":"block_direct_compatibility_rule_access","roles":["anon","authenticated"],"cmd":"ALL","qual":"false","with_check":"false"},{"schemaname":"public","tablename":"catalog_products","policyname":"catalog_products_public_read","roles":["anon","authenticated"],"cmd":"SELECT","qual":"(ativo IS TRUE)","with_check":null},{"schemaname":"public","tablename":"compatibility_requests","policyname":"block_direct_request_access","roles":["anon","authenticated"],"cmd":"ALL","qual":"false","with_check":"false"},{"schemaname":"public","tablename":"compatibility_rule_audit","policyname":"block_direct_compatibility_rule_audit_access","roles":["anon","authenticated"],"cmd":"ALL","qual":"false","with_check":"false"}],"grants":[{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"INSERT"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"SELECT"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"UPDATE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"DELETE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"TRUNCATE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"REFERENCES"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"anon","privilege_type":"TRIGGER"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"INSERT"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"SELECT"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"UPDATE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"DELETE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"TRUNCATE"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"REFERENCES"},{"table_name":"BASE DE DADOS DOS VOLANTES","grantee":"authenticated","privilege_type":"TRIGGER"},{"table_name":"catalog_products","grantee":"anon","privilege_type":"SELECT"},{"table_name":"catalog_products","grantee":"authenticated","privilege_type":"SELECT"}],"functions":[{"proname":"ohc_find_compatible_products","definition":"CREATE OR REPLACE FUNCTION public.ohc_find_compatible_products(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_generation_chassis text, p_vehicle_version text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_brand_key text := public.ohc_normalize_compatibility_text(p_vehicle_brand);\n  v_model_key text := public.ohc_normalize_vehicle_model(p_vehicle_brand, p_vehicle_model);\n  v_generation_key text := public.ohc_normalize_compatibility_text(p_generation_chassis);\n  v_version_key text := public.ohc_normalize_compatibility_text(p_vehicle_version);\n  v_result jsonb;\nbegin\n  if v_brand_key = '' or v_model_key = '' or\n     p_vehicle_year is null or p_vehicle_year < 1950 or p_vehicle_year > 2100 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', false,\n      'reason', 'invalid_input',\n      'products', '[]'::jsonb\n    );\n  end if;\n\n  with candidates as (\n    select\n      rule.id as rule_id,\n      rule.product_sku,\n      rule.product_sku_key,\n      rule.status,\n      rule.updated_at,\n      product.marca,\n      product.nome_produto,\n      product.slug,\n      product.imagem_principal,\n      (case\n        when rule.generation_key = v_generation_key and v_generation_key <> '' then 4\n        when rule.generation_key = '' then 1\n        else 0\n      end) +\n      (case\n        when rule.version_key = v_version_key and v_version_key <> '' then 2\n        when rule.version_key = '' then 1\n        else 0\n      end) as specificity\n    from public.compatibility_rules as rule\n    join public.catalog_products as product\n      on product.ativo\n     and public.ohc_normalize_compatibility_text(product.sku) = rule.product_sku_key\n    where rule.active\n      and rule.vehicle_brand_key = v_brand_key\n      and rule.vehicle_model_key = v_model_key\n      and p_vehicle_year between rule.year_from and rule.year_to\n      and (rule.generation_key = '' or rule.generation_key = v_generation_key)\n      and (rule.version_key = '' or rule.version_key = v_version_key)\n  ), ranked as (\n    select\n      candidates.*,\n      max(specificity) over (partition by product_sku_key) as best_specificity\n    from candidates\n  ), best as (\n    select * from ranked where specificity = best_specificity\n  ), summaries as (\n    select\n      product_sku,\n      product_sku_key,\n      marca,\n      nome_produto,\n      slug,\n      imagem_principal,\n      count(distinct status) as status_count,\n      bool_or(status = 'compativel') as has_compatible,\n      (array_agg(rule_id order by updated_at desc))[1] as rule_id\n    from best\n    group by product_sku, product_sku_key, marca, nome_produto, slug, imagem_principal\n  ), compatible as (\n    select * from summaries where status_count = 1 and has_compatible\n  ), conflicts as (\n    select count(*)::integer as conflict_count from summaries where status_count > 1\n  )\n  select jsonb_build_object(\n    'matched', exists(select 1 from compatible),\n    'conflict', (select conflict_count > 0 from conflicts),\n    'conflict_count', (select conflict_count from conflicts),\n    'products', coalesce((\n      select jsonb_agg(\n        jsonb_build_object(\n          'sku', product_sku,\n          'brand', marca,\n          'name', nome_produto,\n          'slug', slug,\n          'image', imagem_principal,\n          'rule_id', rule_id\n        ) order by marca, nome_produto, product_sku\n      )\n      from compatible\n    ), '[]'::jsonb)\n  ) into v_result;\n\n  return v_result;\nend;\n$function$\n"},{"proname":"ohc_normalize_vehicle_model","definition":"CREATE OR REPLACE FUNCTION public.ohc_normalize_vehicle_model(p_vehicle_brand text, p_vehicle_model text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  select case\n    when public.ohc_normalize_compatibility_text(p_vehicle_model) like\n         public.ohc_normalize_compatibility_text(p_vehicle_brand) || ' %'\n      then trim(substr(\n        public.ohc_normalize_compatibility_text(p_vehicle_model),\n        length(public.ohc_normalize_compatibility_text(p_vehicle_brand)) + 1\n      ))\n    else public.ohc_normalize_compatibility_text(p_vehicle_model)\n  end;\n$function$\n"},{"proname":"ohc_save_compatibility_decision","definition":"CREATE OR REPLACE FUNCTION public.ohc_save_compatibility_decision(p_request_id uuid, p_status text, p_admin_notes text, p_reviewed_by text, p_save_rule boolean, p_year_from integer, p_year_to integer, p_replace_conflicts boolean, p_product_sku text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_request public.compatibility_requests%rowtype;\n  v_product_sku text;\n  v_product_name text;\n  v_product_key text;\n  v_brand_key text;\n  v_model_key text;\n  v_generation_key text;\n  v_version_key text;\n  v_year_from integer;\n  v_year_to integer;\n  v_conflict_ids uuid[] := array[]::uuid[];\n  v_same_status_ids uuid[] := array[]::uuid[];\n  v_rule_id uuid;\n  v_merged_from integer;\n  v_merged_to integer;\nbegin\n  if p_status not in ('analise_necessaria', 'compativel', 'incompativel') then\n    return jsonb_build_object('ok', false, 'error', 'invalid_status');\n  end if;\n\n  select * into v_request\n  from public.compatibility_requests\n  where id = p_request_id\n  for update;\n\n  if not found then\n    return jsonb_build_object('ok', false, 'error', 'request_not_found');\n  end if;\n\n  if p_status = 'analise_necessaria' or not coalesce(p_save_rule, false) then\n    update public.compatibility_requests\n    set\n      status = p_status,\n      admin_notes = nullif(trim(p_admin_notes), ''),\n      reviewed_by = nullif(trim(p_reviewed_by), ''),\n      reviewed_at = case when p_status = 'analise_necessaria' then null else now() end,\n      matched_rule_id = null,\n      decision_source = 'manual_review',\n      conflict_detected = false,\n      updated_at = now()\n    where id = p_request_id;\n\n    return jsonb_build_object('ok', true, 'rule_saved', false, 'status', p_status);\n  end if;\n\n  select product.sku, product.nome_produto\n  into v_product_sku, v_product_name\n  from public.catalog_products as product\n  where product.ativo\n    and lower(trim(product.sku)) = lower(trim(coalesce(\n      nullif(p_product_sku, ''),\n      v_request.requested_product_sku\n    )))\n  limit 1;\n\n  if v_product_sku is null then\n    return jsonb_build_object('ok', false, 'error', 'product_not_found');\n  end if;\n\n  v_year_from := coalesce(p_year_from, v_request.vehicle_year);\n  v_year_to := coalesce(p_year_to, v_request.vehicle_year);\n\n  if v_year_from < 1950 or v_year_to > 2100 or v_year_from > v_year_to then\n    return jsonb_build_object('ok', false, 'error', 'invalid_year_range');\n  end if;\n\n  v_product_key := public.ohc_normalize_compatibility_text(v_product_sku);\n  v_brand_key := public.ohc_normalize_compatibility_text(v_request.vehicle_brand);\n  v_model_key := public.ohc_normalize_vehicle_model(v_request.vehicle_brand, v_request.vehicle_model);\n  v_generation_key := public.ohc_normalize_compatibility_text(v_request.generation_chassis);\n  v_version_key := public.ohc_normalize_compatibility_text(v_request.vehicle_version);\n\n  select coalesce(array_agg(rule.id order by rule.created_at), array[]::uuid[])\n  into v_conflict_ids\n  from public.compatibility_rules as rule\n  where rule.active\n    and rule.product_sku_key = v_product_key\n    and rule.vehicle_brand_key = v_brand_key\n    and rule.vehicle_model_key = v_model_key\n    and rule.generation_key = v_generation_key\n    and rule.version_key = v_version_key\n    and rule.status <> p_status\n    and rule.year_from <= v_year_to\n    and rule.year_to >= v_year_from;\n\n  if cardinality(v_conflict_ids) > 0 and not coalesce(p_replace_conflicts, false) then\n    return jsonb_build_object(\n      'ok', false,\n      'conflict', true,\n      'error', 'conflicting_rule_exists',\n      'conflict_count', cardinality(v_conflict_ids)\n    );\n  end if;\n\n  if cardinality(v_conflict_ids) > 0 then\n    insert into public.compatibility_rule_audit (\n      rule_id, request_id, action, previous_status, new_status, actor, details\n    )\n    select\n      rule.id, p_request_id, 'conflict_replaced', rule.status, p_status,\n      nullif(trim(p_reviewed_by), ''),\n      jsonb_build_object('replacement_year_from', v_year_from, 'replacement_year_to', v_year_to)\n    from public.compatibility_rules as rule\n    where rule.id = any(v_conflict_ids);\n\n    update public.compatibility_rules\n    set active = false, updated_at = now()\n    where id = any(v_conflict_ids);\n  end if;\n\n  select\n    coalesce(array_agg(rule.id order by rule.created_at), array[]::uuid[]),\n    least(v_year_from, coalesce(min(rule.year_from), v_year_from)),\n    greatest(v_year_to, coalesce(max(rule.year_to), v_year_to))\n  into v_same_status_ids, v_merged_from, v_merged_to\n  from public.compatibility_rules as rule\n  where rule.active\n    and rule.product_sku_key = v_product_key\n    and rule.vehicle_brand_key = v_brand_key\n    and rule.vehicle_model_key = v_model_key\n    and rule.generation_key = v_generation_key\n    and rule.version_key = v_version_key\n    and rule.status = p_status\n    and rule.year_from <= v_year_to + 1\n    and rule.year_to + 1 >= v_year_from;\n\n  if cardinality(v_same_status_ids) > 0 then\n    insert into public.compatibility_rule_audit (\n      rule_id, request_id, action, previous_status, new_status, actor, details\n    )\n    select\n      rule.id, p_request_id, 'merged', rule.status, p_status,\n      nullif(trim(p_reviewed_by), ''),\n      jsonb_build_object('merged_year_from', v_merged_from, 'merged_year_to', v_merged_to)\n    from public.compatibility_rules as rule\n    where rule.id = any(v_same_status_ids);\n\n    update public.compatibility_rules\n    set active = false, updated_at = now()\n    where id = any(v_same_status_ids);\n  end if;\n\n  insert into public.compatibility_rules (\n    product_sku, product_sku_key, vehicle_brand, vehicle_brand_key,\n    vehicle_model, vehicle_model_key, generation_chassis, generation_key,\n    vehicle_version, version_key, year_from, year_to, status, admin_notes,\n    evidence_request_id, reviewed_by\n  ) values (\n    v_product_sku, v_product_key, v_request.vehicle_brand, v_brand_key,\n    v_request.vehicle_model, v_model_key,\n    nullif(trim(v_request.generation_chassis), ''), v_generation_key,\n    nullif(trim(v_request.vehicle_version), ''), v_version_key,\n    v_merged_from, v_merged_to, p_status, nullif(trim(p_admin_notes), ''),\n    p_request_id, nullif(trim(p_reviewed_by), '')\n  ) returning id into v_rule_id;\n\n  insert into public.compatibility_rule_audit (\n    rule_id, request_id, action, new_status, actor, details\n  ) values (\n    v_rule_id, p_request_id, 'created', p_status,\n    nullif(trim(p_reviewed_by), ''),\n    jsonb_build_object(\n      'year_from', v_merged_from,\n      'year_to', v_merged_to,\n      'replaced_conflicts', cardinality(v_conflict_ids),\n      'merged_rules', cardinality(v_same_status_ids)\n    )\n  );\n\n  update public.compatibility_requests\n  set\n    status = p_status,\n    requested_product_sku = v_product_sku,\n    requested_product_name = v_product_name,\n    recommended_product_skus = case\n      when p_status = 'compativel' and not (v_product_sku = any(recommended_product_skus))\n        then array_append(recommended_product_skus, v_product_sku)\n      when p_status = 'incompativel'\n        then array_remove(recommended_product_skus, v_product_sku)\n      else recommended_product_skus\n    end,\n    admin_notes = nullif(trim(p_admin_notes), ''),\n    reviewed_by = nullif(trim(p_reviewed_by), ''),\n    reviewed_at = now(),\n    matched_rule_id = v_rule_id,\n    decision_source = 'manual_review',\n    conflict_detected = false,\n    updated_at = now()\n  where id = p_request_id;\n\n  return jsonb_build_object(\n    'ok', true,\n    'rule_saved', true,\n    'rule_id', v_rule_id,\n    'product_sku', v_product_sku,\n    'status', p_status,\n    'year_from', v_merged_from,\n    'year_to', v_merged_to,\n    'replaced_conflicts', cardinality(v_conflict_ids),\n    'merged_rules', cardinality(v_same_status_ids)\n  );\nend;\n$function$\n"},{"proname":"ohc_normalize_vehicle_brand","definition":"CREATE OR REPLACE FUNCTION public.ohc_normalize_vehicle_brand(value text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  with normalized as (\n    select public.ohc_normalize_compatibility_text(value) as key\n  )\n  select case\n    when key in ('bmw', 'b m w', 'bayerische motoren werke') then 'bmw'\n    when key in ('mercedes', 'mercedes benz', 'mercedesbenz', 'benz') then 'mercedes benz'\n    when key in ('vw', 'volks', 'volkswagen') then 'volkswagen'\n    when key in ('audi') then 'audi'\n    when key in ('porsche') then 'porsche'\n    when key in ('ford') then 'ford'\n    when key in ('hyundai') then 'hyundai'\n    when key in ('mitsubishi') then 'mitsubishi'\n    else key\n  end\n  from normalized;\n$function$\n"},{"proname":"ohc_remove_normalized_vehicle_token","definition":"CREATE OR REPLACE FUNCTION public.ohc_remove_normalized_vehicle_token(value text, token text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  with normalized as (\n    select\n      public.ohc_normalize_compatibility_text(value) as value_key,\n      public.ohc_normalize_compatibility_text(token) as token_key\n  )\n  select case\n    when token_key = '' then value_key\n    else trim(\n      regexp_replace(\n        replace(' ' || value_key || ' ', ' ' || token_key || ' ', ' '),\n        '[[:space:]]+',\n        ' ',\n        'g'\n      )\n    )\n  end\n  from normalized;\n$function$\n"},{"proname":"ohc_normalize_vehicle_model_v2","definition":"CREATE OR REPLACE FUNCTION public.ohc_normalize_vehicle_model_v2(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer DEFAULT NULL::integer, p_vehicle_generation text DEFAULT NULL::text, p_chassis_platform text DEFAULT NULL::text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\ndeclare\n  v_brand_key text := public.ohc_normalize_vehicle_brand(p_vehicle_brand);\n  v_raw_brand_key text := public.ohc_normalize_compatibility_text(p_vehicle_brand);\n  v_model_key text := public.ohc_normalize_compatibility_text(p_vehicle_model);\n  v_without_series text;\nbegin\n  v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, v_raw_brand_key);\n  v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, v_brand_key);\n\n  if p_vehicle_year is not null then\n    v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, p_vehicle_year::text);\n    v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, 'ano');\n  end if;\n\n  if public.ohc_normalize_compatibility_text(p_vehicle_generation) <> '' then\n    v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, p_vehicle_generation);\n  end if;\n\n  if public.ohc_normalize_compatibility_text(p_chassis_platform) <> '' then\n    v_model_key := public.ohc_remove_normalized_vehicle_token(v_model_key, p_chassis_platform);\n  end if;\n\n  -- Variações ortográficas exatas e previsíveis, sem distância de edição.\n  v_model_key := replace(v_model_key, 'x drive', 'xdrive');\n\n  if v_brand_key = 'bmw' then\n    v_model_key := regexp_replace(v_model_key, '^m ([0-9])', E'm\\\\1');\n    v_model_key := regexp_replace(\n      v_model_key,\n      '([0-9]{3}) ([ide])($| )',\n      E'\\\\1\\\\2\\\\3',\n      'g'\n    );\n\n    v_without_series := regexp_replace(\n      v_model_key,\n      '^(serie|series) [0-9]+ (.+)$',\n      E'\\\\2'\n    );\n\n    if v_without_series <> '' then\n      v_model_key := v_without_series;\n    end if;\n  end if;\n\n  return public.ohc_normalize_compatibility_text(v_model_key);\nend;\n$function$\n"},{"proname":"ohc_build_vehicle_normalized_key","definition":"CREATE OR REPLACE FUNCTION public.ohc_build_vehicle_normalized_key(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_vehicle_version text DEFAULT NULL::text, p_vehicle_generation text DEFAULT NULL::text, p_chassis_platform text DEFAULT NULL::text, p_motorization text DEFAULT NULL::text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  select concat(\n    public.ohc_normalize_vehicle_brand(p_vehicle_brand), '|',\n    public.ohc_normalize_vehicle_model_v2(\n      p_vehicle_brand,\n      p_vehicle_model,\n      p_vehicle_year,\n      p_vehicle_generation,\n      p_chassis_platform\n    ), '|',\n    coalesce(p_vehicle_year::text, ''), '|',\n    public.ohc_normalize_compatibility_text(p_vehicle_version), '|',\n    public.ohc_normalize_compatibility_text(p_vehicle_generation), '|',\n    public.ohc_normalize_compatibility_text(p_chassis_platform), '|',\n    public.ohc_normalize_compatibility_text(p_motorization)\n  );\n$function$\n"},{"proname":"ohc_get_vehicle_input_keys","definition":"CREATE OR REPLACE FUNCTION public.ohc_get_vehicle_input_keys(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_vehicle_version text DEFAULT NULL::text, p_vehicle_generation text DEFAULT NULL::text, p_chassis_platform text DEFAULT NULL::text, p_motorization text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  select jsonb_build_object(\n    'brand_key', public.ohc_normalize_vehicle_brand(p_vehicle_brand),\n    'model_key', public.ohc_normalize_vehicle_model_v2(\n      p_vehicle_brand,\n      p_vehicle_model,\n      p_vehicle_year,\n      p_vehicle_generation,\n      p_chassis_platform\n    ),\n    'year', p_vehicle_year,\n    'version_key', public.ohc_normalize_compatibility_text(p_vehicle_version),\n    'generation_key', public.ohc_normalize_compatibility_text(p_vehicle_generation),\n    'chassis_platform_key', public.ohc_normalize_compatibility_text(p_chassis_platform),\n    'motorization_key', public.ohc_normalize_compatibility_text(p_motorization),\n    'normalized_key', public.ohc_build_vehicle_normalized_key(\n      p_vehicle_brand,\n      p_vehicle_model,\n      p_vehicle_year,\n      p_vehicle_version,\n      p_vehicle_generation,\n      p_chassis_platform,\n      p_motorization\n    )\n  );\n$function$\n"},{"proname":"ohc_identify_vehicle_profile","definition":"CREATE OR REPLACE FUNCTION public.ohc_identify_vehicle_profile(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_vehicle_version text DEFAULT NULL::text, p_vehicle_generation text DEFAULT NULL::text, p_chassis_platform text DEFAULT NULL::text, p_motorization text DEFAULT NULL::text, p_include_admin_suggestions boolean DEFAULT false)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO ''\nAS $function$\ndeclare\n  v_keys jsonb := public.ohc_get_vehicle_input_keys(\n    p_vehicle_brand,\n    p_vehicle_model,\n    p_vehicle_year,\n    p_vehicle_version,\n    p_vehicle_generation,\n    p_chassis_platform,\n    p_motorization\n  );\n  v_brand_key text := v_keys ->> 'brand_key';\n  v_model_key text := v_keys ->> 'model_key';\n  v_version_key text := v_keys ->> 'version_key';\n  v_generation_key text := v_keys ->> 'generation_key';\n  v_chassis_key text := v_keys ->> 'chassis_platform_key';\n  v_motorization_key text := v_keys ->> 'motorization_key';\n  v_generation_input text;\n  v_chassis_input text;\n  v_candidate_count integer := 0;\n  v_profile jsonb;\n  v_suggestions jsonb := '[]'::jsonb;\nbegin\n  if v_brand_key = ''\n     or v_model_key = ''\n     or p_vehicle_year is null\n     or p_vehicle_year < 1950\n     or p_vehicle_year > 2100 then\n    return jsonb_build_object(\n      'identified', false,\n      'ambiguous', false,\n      'reason', 'invalid_input',\n      'normalized_input', v_keys,\n      'profile', null,\n      'suggestions', '[]'::jsonb\n    );\n  end if;\n\n  v_generation_input := coalesce(nullif(v_generation_key, ''), nullif(v_chassis_key, ''), '');\n  v_chassis_input := coalesce(nullif(v_chassis_key, ''), nullif(v_generation_key, ''), '');\n\n  with candidates as (\n    select\n      profile.*,\n      case\n        when profile.vehicle_model_key = v_model_key then 'canonical_model'\n        else 'approved_alias'\n      end as match_method\n    from public.compatibility_vehicle_profiles as profile\n    where profile.active\n      and profile.vehicle_brand_key = v_brand_key\n      and p_vehicle_year between profile.year_from and profile.year_to\n      and (\n        profile.vehicle_model_key = v_model_key\n        or exists (\n          select 1\n          from public.compatibility_vehicle_aliases as alias\n          where alias.active\n            and alias.vehicle_profile_id = profile.id\n            and alias.alias_kind in ('model', 'manual')\n            and alias.alias_key = v_model_key\n        )\n      )\n      and (\n        profile.version_key = ''\n        or (v_version_key <> '' and profile.version_key = v_version_key)\n      )\n      and (\n        profile.generation_key = ''\n        or (v_generation_input <> '' and profile.generation_key = v_generation_input)\n      )\n      and (\n        profile.chassis_platform_key = ''\n        or (v_chassis_input <> '' and profile.chassis_platform_key = v_chassis_input)\n      )\n      and (\n        profile.motorization_key = ''\n        or (v_motorization_key <> '' and profile.motorization_key = v_motorization_key)\n      )\n  )\n  select\n    count(*)::integer,\n    case\n      when count(*) = 1 then\n        (jsonb_agg(jsonb_build_object(\n          'id', id,\n          'brand', vehicle_brand,\n          'model', vehicle_model,\n          'year_from', year_from,\n          'year_to', year_to,\n          'version', vehicle_version,\n          'generation', vehicle_generation,\n          'chassis_platform', chassis_platform,\n          'motorization', motorization,\n          'normalized_key', normalized_key,\n          'matched_by', match_method\n        )) -> 0)\n      else null\n    end\n  into v_candidate_count, v_profile\n  from candidates;\n\n  if coalesce(p_include_admin_suggestions, false) and v_candidate_count = 0 then\n    with similar_profiles as (\n      select\n        profile.*,\n        array_remove(array[\n          case\n            when p_vehicle_year not between profile.year_from and profile.year_to then 'year'\n          end,\n          case\n            when profile.version_key <> '' and profile.version_key <> v_version_key then 'version'\n          end,\n          case\n            when profile.generation_key <> '' and profile.generation_key <> v_generation_input then 'generation'\n          end,\n          case\n            when profile.chassis_platform_key <> '' and profile.chassis_platform_key <> v_chassis_input then 'chassis_platform'\n          end,\n          case\n            when profile.motorization_key <> '' and profile.motorization_key <> v_motorization_key then 'motorization'\n          end\n        ], null) as mismatch_fields\n      from public.compatibility_vehicle_profiles as profile\n      where profile.active\n        and profile.vehicle_brand_key = v_brand_key\n        and (\n          profile.vehicle_model_key = v_model_key\n          or exists (\n            select 1\n            from public.compatibility_vehicle_aliases as alias\n            where alias.active\n              and alias.vehicle_profile_id = profile.id\n              and alias.alias_kind in ('model', 'manual')\n              and alias.alias_key = v_model_key\n          )\n        )\n      order by\n        abs(p_vehicle_year - greatest(profile.year_from, least(p_vehicle_year, profile.year_to))),\n        profile.updated_at desc,\n        profile.id\n      limit 5\n    )\n    select coalesce(jsonb_agg(jsonb_build_object(\n      'profile_id', id,\n      'brand', vehicle_brand,\n      'model', vehicle_model,\n      'year_from', year_from,\n      'year_to', year_to,\n      'version', vehicle_version,\n      'generation', vehicle_generation,\n      'chassis_platform', chassis_platform,\n      'motorization', motorization,\n      'mismatch_fields', to_jsonb(mismatch_fields),\n      'suggestion_only', true\n    )), '[]'::jsonb)\n    into v_suggestions\n    from similar_profiles;\n  end if;\n\n  return jsonb_build_object(\n    'identified', v_candidate_count = 1,\n    'ambiguous', v_candidate_count > 1,\n    'reason', case\n      when v_candidate_count = 1 then 'exact_profile'\n      when v_candidate_count > 1 then 'ambiguous_profile'\n      else 'profile_not_found'\n    end,\n    'normalized_input', v_keys,\n    'profile', v_profile,\n    'suggestions', case\n      when coalesce(p_include_admin_suggestions, false) then v_suggestions\n      else '[]'::jsonb\n    end\n  );\nend;\n$function$\n"},{"proname":"ohc_record_public_compatibility_query","definition":"CREATE OR REPLACE FUNCTION public.ohc_record_public_compatibility_query(p_protocol text, p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_vehicle_version text, p_vehicle_generation text, p_chassis_platform text, p_motorization text, p_question text, p_consent_data_images boolean)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_resolution jsonb;\n  v_identification jsonb;\n  v_results jsonb := '[]'::jsonb;\n  v_recommended_products jsonb := '[]'::jsonb;\n  v_recommended_skus text[] := array[]::text[];\n  v_status text := 'analise_necessaria';\n  v_public_result text := 'Análise necessária';\n  v_normalized_key text;\n  v_profile_id uuid;\n  v_primary_rule_id uuid;\n  v_decision_batch_id uuid;\n  v_request_id uuid;\n  v_photos_expire_at timestamptz;\n  v_match_priority integer;\n  v_matched boolean := false;\n  v_conflict boolean := false;\nbegin\n  if nullif(trim(coalesce(p_protocol, '')), '') is null\n     or nullif(trim(coalesce(p_vehicle_brand, '')), '') is null\n     or nullif(trim(coalesce(p_vehicle_model, '')), '') is null\n     or p_vehicle_year is null\n     or p_vehicle_year < 1950\n     or p_vehicle_year > 2100\n     or not coalesce(p_consent_data_images, false) then\n    return jsonb_build_object('ok', false, 'error', 'invalid_public_query');\n  end if;\n\n  v_resolution := public.ohc_find_compatibility_memory(\n    p_vehicle_brand,\n    p_vehicle_model,\n    p_vehicle_year,\n    nullif(trim(p_vehicle_version), ''),\n    nullif(trim(p_vehicle_generation), ''),\n    nullif(trim(p_chassis_platform), ''),\n    nullif(trim(p_motorization), ''),\n    false\n  );\n\n  v_results := coalesce(v_resolution -> 'results', '[]'::jsonb);\n  v_normalized_key := v_resolution -> 'normalized_input' ->> 'normalized_key';\n  v_match_priority := nullif(v_resolution ->> 'match_priority', '')::integer;\n  v_matched := coalesce((v_resolution ->> 'matched')::boolean, false);\n  v_conflict := coalesce((v_resolution ->> 'conflict')::boolean, false);\n\n  if v_matched then\n    if exists (\n      select 1 from jsonb_array_elements(v_results) as result(item)\n      where item ->> 'status' = 'compativel'\n    ) then\n      v_status := 'compativel';\n      v_public_result := 'Compatível';\n    elsif exists (\n      select 1 from jsonb_array_elements(v_results) as result(item)\n      where item ->> 'status' = 'compativel_com_condicoes'\n    ) then\n      v_status := 'compativel_com_condicoes';\n      v_public_result := 'Compatível com condições';\n    elsif exists (\n      select 1 from jsonb_array_elements(v_results) as result(item)\n      where item ->> 'status' = 'incompativel'\n    ) then\n      v_status := 'incompativel';\n      v_public_result := 'Não compatível';\n    end if;\n  end if;\n\n  select\n    coalesce(jsonb_agg(item order by item ->> 'brand', item ->> 'name', item ->> 'sku'), '[]'::jsonb),\n    coalesce(array_agg(item ->> 'sku' order by item ->> 'sku'), array[]::text[])\n  into v_recommended_products, v_recommended_skus\n  from jsonb_array_elements(v_results) as result(item)\n  where item ->> 'status' in ('compativel', 'compativel_com_condicoes');\n\n  if v_matched then\n    select\n      nullif(item ->> 'rule_id', '')::uuid,\n      nullif(item ->> 'decision_batch_id', '')::uuid\n    into v_primary_rule_id, v_decision_batch_id\n    from jsonb_array_elements(v_results) as result(item)\n    order by\n      case when item ->> 'status' = v_status then 0 else 1 end,\n      coalesce((item ->> 'match_priority')::integer, 99),\n      item ->> 'sku'\n    limit 1;\n\n    select rule.vehicle_profile_id into v_profile_id\n    from public.compatibility_rules as rule\n    where rule.id = v_primary_rule_id;\n  else\n    v_identification := public.ohc_identify_vehicle_profile(\n      p_vehicle_brand,\n      p_vehicle_model,\n      p_vehicle_year,\n      nullif(trim(p_vehicle_version), ''),\n      nullif(trim(p_vehicle_generation), ''),\n      nullif(trim(p_chassis_platform), ''),\n      nullif(trim(p_motorization), ''),\n      false\n    );\n\n    if coalesce((v_identification ->> 'identified')::boolean, false) then\n      v_profile_id := nullif(v_identification -> 'profile' ->> 'id', '')::uuid;\n    end if;\n  end if;\n\n  insert into public.compatibility_requests (\n    protocol,\n    requested_product_sku,\n    requested_product_name,\n    recommended_product_skus,\n    vehicle_brand,\n    vehicle_model,\n    vehicle_year,\n    vehicle_version,\n    vehicle_generation,\n    vehicle_chassis_platform,\n    vehicle_motorization,\n    generation_chassis,\n    current_steering_notes,\n    customer_name,\n    whatsapp,\n    email,\n    consent_data_images,\n    status,\n    vehicle_profile_id,\n    vehicle_normalized_key,\n    matched_rule_id,\n    decision_batch_id,\n    decision_source,\n    conflict_detected,\n    result_presented\n  ) values (\n    trim(p_protocol),\n    null,\n    null,\n    v_recommended_skus,\n    trim(p_vehicle_brand),\n    trim(p_vehicle_model),\n    p_vehicle_year,\n    nullif(trim(p_vehicle_version), ''),\n    nullif(trim(p_vehicle_generation), ''),\n    nullif(trim(p_chassis_platform), ''),\n    nullif(trim(p_motorization), ''),\n    coalesce(nullif(trim(p_chassis_platform), ''), nullif(trim(p_vehicle_generation), '')),\n    nullif(trim(p_question), ''),\n    null,\n    null,\n    null,\n    true,\n    v_status,\n    v_profile_id,\n    v_normalized_key,\n    v_primary_rule_id,\n    v_decision_batch_id,\n    case\n      when v_matched then 'learned_rule'\n      when v_conflict then 'conflict'\n      else 'manual_review'\n    end,\n    v_conflict,\n    jsonb_build_object(\n      'status', v_status,\n      'public_result', v_public_result,\n      'matched_by_rule', v_matched,\n      'conflict_detected', v_conflict,\n      'match_priority', v_match_priority,\n      'normalized_input', coalesce(v_resolution -> 'normalized_input', '{}'::jsonb),\n      'recommended_products', v_recommended_products,\n      'evaluated_results', v_results,\n      'matched_rule_id', v_primary_rule_id,\n      'decision_batch_id', v_decision_batch_id\n    )\n  )\n  returning id, photos_expire_at into v_request_id, v_photos_expire_at;\n\n  return jsonb_build_object(\n    'ok', true,\n    'request_id', v_request_id,\n    'protocol', trim(p_protocol),\n    'status', v_status,\n    'public_result', v_public_result,\n    'matched_by_rule', v_matched,\n    'conflict_detected', v_conflict,\n    'match_priority', v_match_priority,\n    'recommended_products', v_recommended_products,\n    'evaluated_results', v_results,\n    'photos_expire_at', v_photos_expire_at\n  );\nexception\n  when unique_violation then\n    return jsonb_build_object('ok', false, 'error', 'protocol_collision');\nend;\n$function$\n"},{"proname":"ohc_get_admin_compatibility_context","definition":"CREATE OR REPLACE FUNCTION public.ohc_get_admin_compatibility_context(p_request_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO ''\nAS $function$\ndeclare\n  v_request public.compatibility_requests%rowtype;\n  v_brand_key text;\n  v_model_key text;\n  v_structure_key text;\n  v_version_key text;\n  v_query_count integer := 0;\n  v_similar_cases jsonb := '[]'::jsonb;\n  v_vehicle_suggestions jsonb := '[]'::jsonb;\n  v_rules jsonb := '[]'::jsonb;\n  v_conflicts jsonb := '[]'::jsonb;\nbegin\n  select * into v_request\n  from public.compatibility_requests\n  where id = p_request_id;\n\n  if not found then\n    return jsonb_build_object('ok', false, 'error', 'request_not_found');\n  end if;\n\n  v_brand_key := public.ohc_normalize_vehicle_brand(v_request.vehicle_brand);\n  v_model_key := public.ohc_normalize_vehicle_model_v2(\n    v_request.vehicle_brand,\n    v_request.vehicle_model,\n    v_request.vehicle_year,\n    v_request.vehicle_generation,\n    coalesce(v_request.vehicle_chassis_platform, v_request.generation_chassis)\n  );\n  v_structure_key := public.ohc_normalize_compatibility_text(\n    coalesce(\n      v_request.vehicle_chassis_platform,\n      v_request.vehicle_generation,\n      v_request.generation_chassis\n    )\n  );\n  v_version_key := public.ohc_normalize_compatibility_text(v_request.vehicle_version);\n\n  v_vehicle_suggestions := coalesce(\n    public.ohc_identify_vehicle_profile(\n      v_request.vehicle_brand,\n      v_request.vehicle_model,\n      v_request.vehicle_year,\n      v_request.vehicle_version,\n      v_request.vehicle_generation,\n      coalesce(v_request.vehicle_chassis_platform, v_request.generation_chassis),\n      v_request.vehicle_motorization,\n      true\n    ) -> 'suggestions',\n    '[]'::jsonb\n  );\n\n  select count(*)::integer into v_query_count\n  from public.compatibility_requests as candidate\n  where public.ohc_normalize_vehicle_brand(candidate.vehicle_brand) = v_brand_key\n    and public.ohc_normalize_vehicle_model_v2(\n      candidate.vehicle_brand,\n      candidate.vehicle_model,\n      candidate.vehicle_year,\n      candidate.vehicle_generation,\n      coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis)\n    ) = v_model_key\n    and candidate.vehicle_year = v_request.vehicle_year\n    and public.ohc_normalize_compatibility_text(candidate.vehicle_version) = v_version_key\n    and public.ohc_normalize_compatibility_text(coalesce(\n      candidate.vehicle_chassis_platform,\n      candidate.vehicle_generation,\n      candidate.generation_chassis\n    )) = v_structure_key;\n\n  with similar_requests as (\n    select candidate.*\n    from public.compatibility_requests as candidate\n    where candidate.id <> v_request.id\n      and public.ohc_normalize_vehicle_brand(candidate.vehicle_brand) = v_brand_key\n      and public.ohc_normalize_vehicle_model_v2(\n        candidate.vehicle_brand,\n        candidate.vehicle_model,\n        candidate.vehicle_year,\n        candidate.vehicle_generation,\n        coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis)\n      ) = v_model_key\n    order by\n      abs(candidate.vehicle_year - v_request.vehicle_year),\n      candidate.created_at desc\n    limit 12\n  )\n  select coalesce(jsonb_agg(jsonb_build_object(\n    'id', id,\n    'protocol', protocol,\n    'status', status,\n    'vehicle_brand', vehicle_brand,\n    'vehicle_model', vehicle_model,\n    'vehicle_year', vehicle_year,\n    'vehicle_version', vehicle_version,\n    'generation_chassis', generation_chassis,\n    'question', current_steering_notes,\n    'recommended_product_skus', recommended_product_skus,\n    'decision_source', decision_source,\n    'reviewed_by', reviewed_by,\n    'reviewed_at', reviewed_at,\n    'created_at', created_at,\n    'exact_vehicle',\n      vehicle_year = v_request.vehicle_year\n      and public.ohc_normalize_compatibility_text(vehicle_version) = v_version_key\n      and public.ohc_normalize_compatibility_text(coalesce(\n        vehicle_chassis_platform,\n        vehicle_generation,\n        generation_chassis\n      )) = v_structure_key\n  ) order by created_at desc), '[]'::jsonb)\n  into v_similar_cases\n  from similar_requests;\n\n  with relevant_rules as (\n    select\n      rule.*,\n      profile.vehicle_brand as profile_brand,\n      profile.vehicle_model as profile_model,\n      profile.vehicle_brand_key as profile_brand_key,\n      profile.vehicle_model_key as profile_model_key,\n      profile.vehicle_generation,\n      profile.generation_key as profile_generation_key,\n      profile.chassis_platform,\n      profile.chassis_platform_key,\n      profile.motorization,\n      product.nome_produto as product_name,\n      product.marca as product_brand,\n      product.ativo as product_active\n    from public.compatibility_rules as rule\n    join public.compatibility_vehicle_profiles as profile\n      on profile.id = rule.vehicle_profile_id\n    join public.catalog_products as product\n      on product.id = rule.product_id\n    where profile.vehicle_brand_key = v_brand_key\n      and (\n        profile.vehicle_model_key = v_model_key\n        or (\n          v_structure_key <> ''\n          and profile.chassis_platform_key = v_structure_key\n        )\n      )\n    order by rule.active desc, rule.updated_at desc\n    limit 80\n  )\n  select coalesce(jsonb_agg(jsonb_build_object(\n    'id', id,\n    'decision_batch_id', decision_batch_id,\n    'status', status,\n    'active', active,\n    'scope', rule_scope,\n    'scope_explicitly_approved', scope_explicitly_approved,\n    'year_from', year_from,\n    'year_to', year_to,\n    'vehicle_brand', profile_brand,\n    'vehicle_model', profile_model,\n    'vehicle_generation', vehicle_generation,\n    'chassis_platform', chassis_platform,\n    'motorization', motorization,\n    'vehicle_version', vehicle_version,\n    'product_id', product_id,\n    'product_sku', product_sku,\n    'product_name', product_name,\n    'product_brand', product_brand,\n    'product_active', product_active,\n    'public_notes', public_notes,\n    'internal_notes', internal_notes,\n    'installation_conditions', installation_conditions,\n    'confidence_level', confidence_level,\n    'confirmed_by', confirmed_by,\n    'confirmed_at', confirmed_at,\n    'rule_version', rule_version,\n    'updated_at', updated_at\n  ) order by active desc, updated_at desc), '[]'::jsonb)\n  into v_rules\n  from relevant_rules;\n\n  with active_relevant as (\n    select\n      rule.product_id,\n      product.sku,\n      product.nome_produto,\n      count(distinct rule.status) as status_count,\n      array_agg(rule.id order by rule.updated_at desc) as rule_ids,\n      array_agg(distinct rule.status) as statuses\n    from public.compatibility_rules as rule\n    join public.compatibility_vehicle_profiles as profile\n      on profile.id = rule.vehicle_profile_id\n    join public.catalog_products as product\n      on product.id = rule.product_id\n    where rule.active\n      and profile.vehicle_brand_key = v_brand_key\n      and (\n        profile.vehicle_model_key = v_model_key\n        or (v_structure_key <> '' and profile.chassis_platform_key = v_structure_key)\n      )\n      and v_request.vehicle_year between rule.year_from and rule.year_to\n    group by rule.product_id, product.sku, product.nome_produto\n  )\n  select coalesce(jsonb_agg(jsonb_build_object(\n    'product_id', product_id,\n    'sku', sku,\n    'product_name', nome_produto,\n    'rule_ids', to_jsonb(rule_ids),\n    'statuses', to_jsonb(statuses)\n  )), '[]'::jsonb)\n  into v_conflicts\n  from active_relevant\n  where status_count > 1;\n\n  return jsonb_build_object(\n    'ok', true,\n    'request', jsonb_build_object(\n      'id', v_request.id,\n      'protocol', v_request.protocol,\n      'status', v_request.status,\n      'vehicle_brand', v_request.vehicle_brand,\n      'vehicle_model', v_request.vehicle_model,\n      'vehicle_year', v_request.vehicle_year,\n      'vehicle_version', v_request.vehicle_version,\n      'vehicle_generation', v_request.vehicle_generation,\n      'vehicle_chassis_platform', v_request.vehicle_chassis_platform,\n      'vehicle_motorization', v_request.vehicle_motorization,\n      'generation_chassis', v_request.generation_chassis,\n      'question', v_request.current_steering_notes,\n      'internal_notes', v_request.admin_notes,\n      'recommended_product_skus', v_request.recommended_product_skus,\n      'decision_source', v_request.decision_source,\n      'conflict_detected', v_request.conflict_detected,\n      'reviewed_by', v_request.reviewed_by,\n      'reviewed_at', v_request.reviewed_at,\n      'created_at', v_request.created_at,\n      'photos_expire_at', v_request.photos_expire_at,\n      'query_count', v_query_count\n    ),\n    'similar_cases', v_similar_cases,\n    'vehicle_suggestions', v_vehicle_suggestions,\n    'rules', v_rules,\n    'conflicts', v_conflicts\n  );\nend;\n$function$\n"},{"proname":"ohc_consume_public_rate_limit","definition":"CREATE OR REPLACE FUNCTION public.ohc_consume_public_rate_limit()\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_now timestamptz := clock_timestamp();\n  v_window_started_at timestamptz;\n  v_request_count integer;\n  v_limit constant integer := 60;\n  v_window_seconds constant integer := 60;\n  v_retry_after integer;\nbegin\n  insert into public.compatibility_public_rate_limits (\n    scope,\n    window_started_at,\n    request_count,\n    updated_at\n  ) values (\n    'public-submit-global',\n    v_now,\n    1,\n    v_now\n  )\n  on conflict (scope) do update set\n    window_started_at = case\n      when public.compatibility_public_rate_limits.window_started_at <= v_now - make_interval(secs => v_window_seconds)\n        then v_now\n      else public.compatibility_public_rate_limits.window_started_at\n    end,\n    request_count = case\n      when public.compatibility_public_rate_limits.window_started_at <= v_now - make_interval(secs => v_window_seconds)\n        then 1\n      else public.compatibility_public_rate_limits.request_count + 1\n    end,\n    updated_at = v_now\n  returning window_started_at, request_count\n    into v_window_started_at, v_request_count;\n\n  v_retry_after := greatest(\n    1,\n    ceil(v_window_seconds - extract(epoch from (v_now - v_window_started_at)))::integer\n  );\n\n  return jsonb_build_object(\n    'allowed', v_request_count <= v_limit,\n    'limit', v_limit,\n    'remaining', greatest(v_limit - v_request_count, 0),\n    'retry_after', case when v_request_count <= v_limit then 0 else v_retry_after end\n  );\nend;\n$function$\n"},{"proname":"ohc_find_compatibility_memory","definition":"CREATE OR REPLACE FUNCTION public.ohc_find_compatibility_memory(p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_vehicle_version text DEFAULT NULL::text, p_vehicle_generation text DEFAULT NULL::text, p_chassis_platform text DEFAULT NULL::text, p_motorization text DEFAULT NULL::text, p_include_admin_suggestions boolean DEFAULT false)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO ''\nAS $function$\ndeclare\n  v_keys jsonb := public.ohc_get_vehicle_input_keys(\n    p_vehicle_brand,\n    p_vehicle_model,\n    p_vehicle_year,\n    p_vehicle_version,\n    p_vehicle_generation,\n    p_chassis_platform,\n    p_motorization\n  );\n  v_brand_key text := v_keys ->> 'brand_key';\n  v_model_key text := v_keys ->> 'model_key';\n  v_version_key text := v_keys ->> 'version_key';\n  v_generation_key text := v_keys ->> 'generation_key';\n  v_chassis_key text := v_keys ->> 'chassis_platform_key';\n  v_motorization_key text := v_keys ->> 'motorization_key';\n  v_generation_input text;\n  v_chassis_input text;\n  v_results jsonb := '[]'::jsonb;\n  v_conflicts jsonb := '[]'::jsonb;\n  v_conflict_count integer := 0;\n  v_match_priority integer;\n  v_identification jsonb;\nbegin\n  if v_brand_key = ''\n     or v_model_key = ''\n     or p_vehicle_year is null\n     or p_vehicle_year < 1950\n     or p_vehicle_year > 2100 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', false,\n      'reason', 'invalid_input',\n      'status', 'analise_necessaria',\n      'normalized_input', v_keys,\n      'results', '[]'::jsonb,\n      'suggestions', '[]'::jsonb\n    );\n  end if;\n\n  v_generation_input := coalesce(nullif(v_generation_key, ''), nullif(v_chassis_key, ''), '');\n  v_chassis_input := coalesce(nullif(v_chassis_key, ''), nullif(v_generation_key, ''), '');\n\n  with base_candidates as (\n    select\n      rule.id as rule_id,\n      rule.decision_batch_id,\n      rule.status,\n      rule.rule_scope,\n      rule.scope_explicitly_approved,\n      rule.public_notes,\n      rule.installation_conditions,\n      rule.rule_version,\n      rule.updated_at,\n      product.id as product_id,\n      product.sku,\n      product.marca as product_brand,\n      product.nome_produto as product_name,\n      product.slug,\n      product.imagem_principal as product_image,\n      profile.vehicle_model_key = v_model_key\n        or exists (\n          select 1\n          from public.compatibility_vehicle_aliases as alias\n          where alias.active\n            and alias.vehicle_profile_id = profile.id\n            and alias.alias_kind in ('model', 'manual')\n            and alias.alias_key = v_model_key\n        ) as model_matches,\n      profile.version_key,\n      profile.generation_key,\n      profile.chassis_platform_key,\n      profile.motorization_key\n    from public.compatibility_rules as rule\n    join public.compatibility_vehicle_profiles as profile\n      on profile.id = rule.vehicle_profile_id\n     and profile.active\n    join public.catalog_products as product\n      on product.id = rule.product_id\n     and product.ativo\n    where rule.active\n      and rule.status in ('compativel', 'incompativel', 'compativel_com_condicoes')\n      and profile.vehicle_brand_key = v_brand_key\n      and p_vehicle_year between rule.year_from and rule.year_to\n      and p_vehicle_year between profile.year_from and profile.year_to\n  ), scoped_candidates as (\n    select\n      base_candidates.*,\n      case rule_scope\n        when 'exact_vehicle_version' then 1\n        when 'model_year_range' then 2\n        when 'generation' then 3\n        when 'chassis_platform' then 4\n      end as match_priority\n    from base_candidates\n    where case rule_scope\n      when 'exact_vehicle_version' then\n        model_matches\n        and version_key <> ''\n        and version_key = v_version_key\n        and (generation_key = '' or generation_key = v_generation_input)\n        and (chassis_platform_key = '' or chassis_platform_key = v_chassis_input)\n        and (motorization_key = '' or motorization_key = v_motorization_key)\n      when 'model_year_range' then\n        model_matches\n        and (version_key = '' or version_key = v_version_key)\n        and (generation_key = '' or generation_key = v_generation_input)\n        and (chassis_platform_key = '' or chassis_platform_key = v_chassis_input)\n        and (motorization_key = '' or motorization_key = v_motorization_key)\n      when 'generation' then\n        scope_explicitly_approved\n        and model_matches\n        and v_generation_input <> ''\n        and generation_key = v_generation_input\n      when 'chassis_platform' then\n        scope_explicitly_approved\n        and v_chassis_input <> ''\n        and chassis_platform_key = v_chassis_input\n      else false\n    end\n  ), ranked as (\n    select\n      scoped_candidates.*,\n      min(match_priority) over (partition by product_id) as best_priority\n    from scoped_candidates\n  ), best as (\n    select *\n    from ranked\n    where match_priority = best_priority\n  ), summaries as (\n    select\n      product_id,\n      sku,\n      product_brand,\n      product_name,\n      slug,\n      product_image,\n      min(match_priority) as match_priority,\n      count(distinct status)::integer as status_count,\n      (array_agg(status order by updated_at desc, rule_id))[1] as status,\n      (array_agg(rule_id order by updated_at desc, rule_id))[1] as rule_id,\n      (array_agg(decision_batch_id order by updated_at desc, rule_id))[1] as decision_batch_id,\n      (array_agg(rule_scope order by updated_at desc, rule_id))[1] as rule_scope,\n      (array_agg(public_notes order by updated_at desc, rule_id))[1] as public_notes,\n      (array_agg(installation_conditions order by updated_at desc, rule_id))[1] as installation_conditions,\n      (array_agg(rule_version order by updated_at desc, rule_id))[1] as rule_version,\n      array_agg(rule_id order by updated_at desc, rule_id) as rule_ids\n    from best\n    group by product_id, sku, product_brand, product_name, slug, product_image\n  )\n  select\n    coalesce(jsonb_agg(jsonb_build_object(\n      'product_id', product_id,\n      'sku', sku,\n      'brand', product_brand,\n      'name', product_name,\n      'slug', slug,\n      'image', product_image,\n      'status', status,\n      'result_label', case status\n        when 'compativel' then 'Compatível'\n        when 'incompativel' then 'Não compatível'\n        when 'compativel_com_condicoes' then 'Compatível com condições'\n      end,\n      'rule_id', rule_id,\n      'decision_batch_id', decision_batch_id,\n      'rule_scope', rule_scope,\n      'match_priority', match_priority,\n      'public_notes', public_notes,\n      'installation_conditions', installation_conditions,\n      'rule_version', rule_version\n    ) order by match_priority, product_brand, product_name, sku)\n      filter (where status_count = 1), '[]'::jsonb),\n    coalesce(jsonb_agg(jsonb_build_object(\n      'product_id', product_id,\n      'sku', sku,\n      'name', product_name,\n      'rule_ids', to_jsonb(rule_ids),\n      'requires_admin_confirmation', true\n    )) filter (where status_count > 1), '[]'::jsonb),\n    (count(*) filter (where status_count > 1))::integer,\n    min(match_priority)\n  into v_results, v_conflicts, v_conflict_count, v_match_priority\n  from summaries;\n\n  if coalesce(v_conflict_count, 0) > 0 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', true,\n      'reason', 'rule_conflict',\n      'status', 'analise_necessaria',\n      'normalized_input', v_keys,\n      'match_priority', v_match_priority,\n      'results', '[]'::jsonb,\n      'conflicts', v_conflicts,\n      'suggestions', '[]'::jsonb\n    );\n  end if;\n\n  if jsonb_array_length(v_results) > 0 then\n    return jsonb_build_object(\n      'matched', true,\n      'conflict', false,\n      'reason', 'approved_rule',\n      'status', 'regra_aprovada',\n      'normalized_input', v_keys,\n      'match_priority', v_match_priority,\n      'results', v_results,\n      'conflicts', '[]'::jsonb,\n      'suggestions', '[]'::jsonb\n    );\n  end if;\n\n  v_identification := public.ohc_identify_vehicle_profile(\n    p_vehicle_brand,\n    p_vehicle_model,\n    p_vehicle_year,\n    p_vehicle_version,\n    p_vehicle_generation,\n    p_chassis_platform,\n    p_motorization,\n    coalesce(p_include_admin_suggestions, false)\n  );\n\n  return jsonb_build_object(\n    'matched', false,\n    'conflict', false,\n    'reason', 'analysis_required',\n    'status', 'analise_necessaria',\n    'normalized_input', v_keys,\n    'match_priority', null,\n    'results', '[]'::jsonb,\n    'conflicts', '[]'::jsonb,\n    'suggestions', case\n      when coalesce(p_include_admin_suggestions, false)\n        then coalesce(v_identification -> 'suggestions', '[]'::jsonb)\n      else '[]'::jsonb\n    end\n  );\nend;\n$function$\n"},{"proname":"ohc_save_compatibility_decision_v2","definition":"CREATE OR REPLACE FUNCTION public.ohc_save_compatibility_decision_v2(p_request_id uuid, p_status text, p_product_ids bigint[], p_public_notes text, p_internal_notes text, p_installation_conditions text, p_confidence_level text, p_rule_scope text, p_year_from integer, p_year_to integer, p_reviewed_by text, p_save_rule boolean, p_replace_conflicts boolean, p_scope_explicitly_approved boolean, p_change_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_request public.compatibility_requests%rowtype;\n  v_profile_id uuid;\n  v_profile_key text;\n  v_batch_id uuid := gen_random_uuid();\n  v_brand_key text;\n  v_model_key text;\n  v_version_key text;\n  v_generation_key text;\n  v_chassis_key text;\n  v_motorization_key text;\n  v_rule_structure text;\n  v_rule_structure_key text;\n  v_year_from integer;\n  v_year_to integer;\n  v_product_count integer := 0;\n  v_product_ids bigint[] := array[]::bigint[];\n  v_product_skus text[] := array[]::text[];\n  v_conflict_ids uuid[] := array[]::uuid[];\n  v_conflicts jsonb := '[]'::jsonb;\n  v_rule_ids uuid[] := array[]::uuid[];\n  v_same_ids uuid[];\n  v_rule_id uuid;\n  v_primary_rule_id uuid;\n  v_resolved_count integer := 0;\n  v_product record;\n  v_existing public.compatibility_rules%rowtype;\n  v_previous jsonb;\n  v_new jsonb;\nbegin\n  if p_status not in (\n    'analise_necessaria',\n    'compativel',\n    'incompativel',\n    'compativel_com_condicoes'\n  ) then\n    return jsonb_build_object('ok', false, 'error', 'invalid_status');\n  end if;\n\n  if p_confidence_level not in ('low', 'medium', 'high', 'confirmed') then\n    return jsonb_build_object('ok', false, 'error', 'invalid_confidence');\n  end if;\n\n  if p_rule_scope not in (\n    'exact_vehicle_version',\n    'model_year_range',\n    'generation',\n    'chassis_platform'\n  ) then\n    return jsonb_build_object('ok', false, 'error', 'invalid_scope');\n  end if;\n\n  select * into v_request\n  from public.compatibility_requests\n  where id = p_request_id\n  for update;\n\n  if not found then\n    return jsonb_build_object('ok', false, 'error', 'request_not_found');\n  end if;\n\n  select\n    count(*)::integer,\n    coalesce(array_agg(product.id order by product.id), array[]::bigint[]),\n    coalesce(array_agg(product.sku order by product.id), array[]::text[])\n  into v_product_count, v_product_ids, v_product_skus\n  from public.catalog_products as product\n  where product.ativo\n    and product.id = any(coalesce(p_product_ids, array[]::bigint[]));\n\n  if p_status <> 'analise_necessaria'\n     and (\n       v_product_count = 0\n       or v_product_count <> cardinality(array(select distinct unnest(coalesce(p_product_ids, array[]::bigint[]))))\n     ) then\n    return jsonb_build_object('ok', false, 'error', 'active_products_required');\n  end if;\n\n  if p_status = 'compativel_com_condicoes'\n     and nullif(trim(coalesce(p_installation_conditions, '')), '') is null then\n    return jsonb_build_object('ok', false, 'error', 'conditions_required');\n  end if;\n\n  if p_status = 'analise_necessaria' or not coalesce(p_save_rule, false) then\n    update public.compatibility_requests\n    set\n      status = p_status,\n      recommended_product_skus = case\n        when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n        else array[]::text[]\n      end,\n      admin_notes = nullif(trim(p_internal_notes), ''),\n      reviewed_by = case\n        when p_status = 'analise_necessaria' then null\n        else nullif(trim(p_reviewed_by), '')\n      end,\n      reviewed_at = case\n        when p_status = 'analise_necessaria' then null\n        else now()\n      end,\n      matched_rule_id = null,\n      decision_batch_id = case\n        when p_status = 'analise_necessaria' then null\n        else v_batch_id\n      end,\n      decision_source = 'manual_review',\n      conflict_detected = false,\n      result_presented = jsonb_build_object(\n        'status', p_status,\n        'recommended_product_skus', case\n          when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n          else array[]::text[]\n        end,\n        'public_notes', nullif(trim(p_public_notes), ''),\n        'installation_conditions', nullif(trim(p_installation_conditions), ''),\n        'saved_as_rule', false\n      ),\n      updated_at = now()\n    where id = p_request_id;\n\n    return jsonb_build_object(\n      'ok', true,\n      'rule_saved', false,\n      'status', p_status,\n      'decision_batch_id', v_batch_id,\n      'resolved_equivalent_requests', 0\n    );\n  end if;\n\n  if p_status = 'analise_necessaria' then\n    return jsonb_build_object('ok', false, 'error', 'analysis_cannot_create_rule');\n  end if;\n\n  v_year_from := case\n    when p_rule_scope = 'exact_vehicle_version' then v_request.vehicle_year\n    else coalesce(p_year_from, v_request.vehicle_year)\n  end;\n  v_year_to := case\n    when p_rule_scope = 'exact_vehicle_version' then v_request.vehicle_year\n    else coalesce(p_year_to, v_request.vehicle_year)\n  end;\n\n  if v_year_from < 1950 or v_year_to > 2100 or v_year_from > v_year_to then\n    return jsonb_build_object('ok', false, 'error', 'invalid_year_range');\n  end if;\n\n  v_brand_key := public.ohc_normalize_vehicle_brand(v_request.vehicle_brand);\n  v_model_key := public.ohc_normalize_vehicle_model_v2(\n    v_request.vehicle_brand,\n    v_request.vehicle_model,\n    v_request.vehicle_year,\n    v_request.vehicle_generation,\n    coalesce(v_request.vehicle_chassis_platform, v_request.generation_chassis)\n  );\n  v_version_key := case\n    when p_rule_scope = 'exact_vehicle_version'\n      then public.ohc_normalize_compatibility_text(v_request.vehicle_version)\n    else ''\n  end;\n  v_generation_key := case\n    when p_rule_scope = 'generation'\n      then public.ohc_normalize_compatibility_text(coalesce(\n        v_request.vehicle_generation,\n        v_request.generation_chassis\n      ))\n    else ''\n  end;\n  v_chassis_key := case\n    when p_rule_scope in ('exact_vehicle_version', 'model_year_range', 'chassis_platform')\n      then public.ohc_normalize_compatibility_text(coalesce(\n        v_request.vehicle_chassis_platform,\n        v_request.generation_chassis\n      ))\n    else ''\n  end;\n  v_motorization_key := case\n    when p_rule_scope = 'exact_vehicle_version'\n      then public.ohc_normalize_compatibility_text(v_request.vehicle_motorization)\n    else ''\n  end;\n\n  if p_rule_scope = 'exact_vehicle_version' and v_version_key = '' then\n    return jsonb_build_object('ok', false, 'error', 'version_required_for_exact_scope');\n  end if;\n\n  if p_rule_scope = 'generation'\n     and (v_generation_key = '' or not coalesce(p_scope_explicitly_approved, false)) then\n    return jsonb_build_object('ok', false, 'error', 'explicit_generation_approval_required');\n  end if;\n\n  if p_rule_scope = 'chassis_platform'\n     and (v_chassis_key = '' or not coalesce(p_scope_explicitly_approved, false)) then\n    return jsonb_build_object('ok', false, 'error', 'explicit_chassis_approval_required');\n  end if;\n\n  v_rule_structure := case\n    when p_rule_scope = 'generation' then coalesce(v_request.vehicle_generation, v_request.generation_chassis)\n    else coalesce(v_request.vehicle_chassis_platform, v_request.generation_chassis)\n  end;\n  v_rule_structure_key := case\n    when p_rule_scope = 'generation' then v_generation_key\n    else v_chassis_key\n  end;\n\n  -- Reaproveita e amplia faixas equivalentes do mesmo resultado, evitando\n  -- criar regras ativas duplicadas para anos sobrepostos ou adjacentes.\n  select\n    least(v_year_from, coalesce(min(rule.year_from), v_year_from)),\n    greatest(v_year_to, coalesce(max(rule.year_to), v_year_to))\n  into v_year_from, v_year_to\n  from public.compatibility_rules as rule\n  where rule.active\n    and rule.product_id = any(v_product_ids)\n    and rule.vehicle_brand_key = v_brand_key\n    and rule.vehicle_model_key = v_model_key\n    and rule.generation_key = v_rule_structure_key\n    and rule.version_key = v_version_key\n    and rule.status = p_status\n    and rule.year_from <= v_year_to + 1\n    and rule.year_to + 1 >= v_year_from;\n\n  v_profile_key := concat(\n    v_brand_key, '|', v_model_key, '|', v_year_from, '-', v_year_to, '|',\n    v_version_key, '|', v_generation_key, '|', v_chassis_key, '|', v_motorization_key\n  );\n\n  insert into public.compatibility_vehicle_profiles (\n    vehicle_brand,\n    vehicle_brand_key,\n    vehicle_model,\n    vehicle_model_key,\n    year_from,\n    year_to,\n    vehicle_version,\n    version_key,\n    vehicle_generation,\n    generation_key,\n    chassis_platform,\n    chassis_platform_key,\n    motorization,\n    motorization_key,\n    normalized_key\n  ) values (\n    v_request.vehicle_brand,\n    v_brand_key,\n    v_request.vehicle_model,\n    v_model_key,\n    v_year_from,\n    v_year_to,\n    case when v_version_key <> '' then v_request.vehicle_version else null end,\n    v_version_key,\n    case when v_generation_key <> '' then v_rule_structure else null end,\n    v_generation_key,\n    case when v_chassis_key <> '' then v_rule_structure else null end,\n    v_chassis_key,\n    case when v_motorization_key <> '' then v_request.vehicle_motorization else null end,\n    v_motorization_key,\n    v_profile_key\n  )\n  on conflict (normalized_key) do update set\n    active = true,\n    updated_at = now()\n  returning id into v_profile_id;\n\n  -- Conflitos abrangem qualquer regra ativa que possa responder o mesmo\n  -- produto, marca, anos e estrutura com outro resultado.\n  with conflicts as (\n    select\n      rule.id,\n      rule.status,\n      rule.rule_scope,\n      rule.product_id,\n      rule.product_sku,\n      rule.year_from,\n      rule.year_to,\n      rule.public_notes,\n      rule.installation_conditions,\n      rule.rule_version,\n      profile.vehicle_model_key,\n      profile.generation_key,\n      profile.chassis_platform_key\n    from public.compatibility_rules as rule\n    join public.compatibility_vehicle_profiles as profile\n      on profile.id = rule.vehicle_profile_id\n    where rule.active\n      and rule.product_id = any(v_product_ids)\n      and profile.vehicle_brand_key = v_brand_key\n      and rule.status <> p_status\n      and rule.year_from <= v_year_to\n      and rule.year_to >= v_year_from\n      and (\n        (\n          p_rule_scope = 'chassis_platform'\n          and v_chassis_key <> ''\n          and profile.chassis_platform_key = v_chassis_key\n        )\n        or (\n          rule.rule_scope = 'chassis_platform'\n          and profile.chassis_platform_key <> ''\n          and profile.chassis_platform_key = v_chassis_key\n        )\n        or (\n          profile.vehicle_model_key = v_model_key\n          and (\n            profile.generation_key = ''\n            or v_generation_key = ''\n            or profile.generation_key = v_generation_key\n          )\n          and (\n            profile.chassis_platform_key = ''\n            or v_chassis_key = ''\n            or profile.chassis_platform_key = v_chassis_key\n          )\n        )\n      )\n  )\n  select\n    coalesce(array_agg(id order by id), array[]::uuid[]),\n    coalesce(jsonb_agg(jsonb_build_object(\n      'rule_id', id,\n      'product_id', product_id,\n      'product_sku', product_sku,\n      'previous_status', status,\n      'new_status', p_status,\n      'scope', rule_scope,\n      'year_from', year_from,\n      'year_to', year_to,\n      'public_notes', public_notes,\n      'installation_conditions', installation_conditions,\n      'rule_version', rule_version\n    )), '[]'::jsonb)\n  into v_conflict_ids, v_conflicts\n  from conflicts;\n\n  if cardinality(v_conflict_ids) > 0 and not coalesce(p_replace_conflicts, false) then\n    return jsonb_build_object(\n      'ok', false,\n      'conflict', true,\n      'error', 'conflicting_rules_require_confirmation',\n      'conflict_count', cardinality(v_conflict_ids),\n      'conflicts', v_conflicts,\n      'proposed_response', jsonb_build_object(\n        'status', p_status,\n        'product_ids', to_jsonb(v_product_ids),\n        'scope', p_rule_scope,\n        'year_from', v_year_from,\n        'year_to', v_year_to,\n        'public_notes', nullif(trim(p_public_notes), ''),\n        'installation_conditions', nullif(trim(p_installation_conditions), '')\n      )\n    );\n  end if;\n\n  if cardinality(v_conflict_ids) > 0 then\n    insert into public.compatibility_rule_audit (\n      rule_id,\n      request_id,\n      decision_batch_id,\n      action,\n      previous_status,\n      new_status,\n      actor,\n      previous_response,\n      new_response,\n      change_reason,\n      previous_rule_version,\n      new_rule_version,\n      details\n    )\n    select\n      rule.id,\n      p_request_id,\n      v_batch_id,\n      'corrected',\n      rule.status,\n      p_status,\n      nullif(trim(p_reviewed_by), ''),\n      jsonb_build_object(\n        'status', rule.status,\n        'active', rule.active,\n        'scope', rule.rule_scope,\n        'year_from', rule.year_from,\n        'year_to', rule.year_to,\n        'public_notes', rule.public_notes,\n        'installation_conditions', rule.installation_conditions\n      ),\n      jsonb_build_object(\n        'status', p_status,\n        'active', false,\n        'replacement_batch_id', v_batch_id\n      ),\n      coalesce(nullif(trim(p_change_reason), ''), 'Correção de regra conflitante'),\n      rule.rule_version,\n      rule.rule_version + 1,\n      jsonb_build_object('replacement_confirmed', true)\n    from public.compatibility_rules as rule\n    where rule.id = any(v_conflict_ids);\n\n    update public.compatibility_rules\n    set\n      active = false,\n      rule_version = rule_version + 1,\n      updated_at = now()\n    where id = any(v_conflict_ids);\n  end if;\n\n  for v_product in\n    select product.id, product.sku\n    from public.catalog_products as product\n    where product.id = any(v_product_ids)\n    order by product.id\n  loop\n    select coalesce(array_agg(rule.id order by rule.created_at), array[]::uuid[])\n    into v_same_ids\n    from public.compatibility_rules as rule\n    where rule.active\n      and rule.product_id = v_product.id\n      and rule.vehicle_brand_key = v_brand_key\n      and rule.vehicle_model_key = v_model_key\n      and rule.generation_key = v_rule_structure_key\n      and rule.version_key = v_version_key\n      and rule.status = p_status\n      and rule.year_from <= v_year_to + 1\n      and rule.year_to + 1 >= v_year_from;\n\n    if cardinality(v_same_ids) = 1 then\n      select * into v_existing\n      from public.compatibility_rules\n      where id = v_same_ids[1]\n      for update;\n\n      v_previous := jsonb_build_object(\n        'status', v_existing.status,\n        'active', v_existing.active,\n        'scope', v_existing.rule_scope,\n        'year_from', v_existing.year_from,\n        'year_to', v_existing.year_to,\n        'public_notes', v_existing.public_notes,\n        'internal_notes', v_existing.internal_notes,\n        'installation_conditions', v_existing.installation_conditions,\n        'confidence_level', v_existing.confidence_level,\n        'product_id', v_existing.product_id\n      );\n\n      update public.compatibility_rules\n      set\n        vehicle_profile_id = v_profile_id,\n        decision_batch_id = v_batch_id,\n        year_from = least(year_from, v_year_from),\n        year_to = greatest(year_to, v_year_to),\n        rule_scope = p_rule_scope,\n        scope_explicitly_approved = case\n          when p_rule_scope in ('generation', 'chassis_platform') then true\n          else false\n        end,\n        public_notes = nullif(trim(p_public_notes), ''),\n        internal_notes = nullif(trim(p_internal_notes), ''),\n        admin_notes = nullif(trim(p_internal_notes), ''),\n        installation_conditions = nullif(trim(p_installation_conditions), ''),\n        confidence_level = p_confidence_level,\n        confirmed_by = nullif(trim(p_reviewed_by), ''),\n        confirmed_at = now(),\n        reviewed_by = nullif(trim(p_reviewed_by), ''),\n        evidence_request_id = p_request_id,\n        rule_version = rule_version + 1,\n        updated_at = now()\n      where id = v_existing.id\n      returning id into v_rule_id;\n\n      select jsonb_build_object(\n        'status', rule.status,\n        'active', rule.active,\n        'scope', rule.rule_scope,\n        'year_from', rule.year_from,\n        'year_to', rule.year_to,\n        'public_notes', rule.public_notes,\n        'internal_notes', rule.internal_notes,\n        'installation_conditions', rule.installation_conditions,\n        'confidence_level', rule.confidence_level,\n        'product_id', rule.product_id\n      ) into v_new\n      from public.compatibility_rules as rule\n      where rule.id = v_rule_id;\n\n      insert into public.compatibility_rule_audit (\n        rule_id, request_id, decision_batch_id, action,\n        previous_status, new_status, actor,\n        previous_response, new_response, change_reason,\n        previous_rule_version, new_rule_version, details\n      ) values (\n        v_rule_id, p_request_id, v_batch_id, 'updated',\n        p_status, p_status, nullif(trim(p_reviewed_by), ''),\n        v_previous, v_new,\n        coalesce(nullif(trim(p_change_reason), ''), 'Atualização administrativa'),\n        v_existing.rule_version, v_existing.rule_version + 1,\n        jsonb_build_object('product_id', v_product.id, 'product_sku', v_product.sku)\n      );\n    else\n      if cardinality(v_same_ids) > 1 then\n        insert into public.compatibility_rule_audit (\n          rule_id, request_id, decision_batch_id, action,\n          previous_status, new_status, actor,\n          previous_response, new_response, change_reason,\n          previous_rule_version, new_rule_version, details\n        )\n        select\n          rule.id, p_request_id, v_batch_id, 'merged',\n          rule.status, p_status, nullif(trim(p_reviewed_by), ''),\n          jsonb_build_object(\n            'status', rule.status,\n            'active', rule.active,\n            'year_from', rule.year_from,\n            'year_to', rule.year_to\n          ),\n          jsonb_build_object('status', p_status, 'active', false, 'merged_into_batch', v_batch_id),\n          coalesce(nullif(trim(p_change_reason), ''), 'Consolidação de regras equivalentes'),\n          rule.rule_version, rule.rule_version + 1,\n          jsonb_build_object('product_id', v_product.id)\n        from public.compatibility_rules as rule\n        where rule.id = any(v_same_ids);\n\n        update public.compatibility_rules\n        set active = false, rule_version = rule_version + 1, updated_at = now()\n        where id = any(v_same_ids);\n      end if;\n\n      insert into public.compatibility_rules (\n        product_id,\n        product_sku,\n        product_sku_key,\n        vehicle_profile_id,\n        decision_batch_id,\n        vehicle_brand,\n        vehicle_brand_key,\n        vehicle_model,\n        vehicle_model_key,\n        generation_chassis,\n        generation_key,\n        vehicle_version,\n        version_key,\n        year_from,\n        year_to,\n        status,\n        rule_scope,\n        scope_explicitly_approved,\n        public_notes,\n        internal_notes,\n        admin_notes,\n        installation_conditions,\n        confidence_level,\n        confirmed_by,\n        confirmed_at,\n        evidence_request_id,\n        reviewed_by,\n        rule_version,\n        active\n      ) values (\n        v_product.id,\n        v_product.sku,\n        public.ohc_normalize_compatibility_text(v_product.sku),\n        v_profile_id,\n        v_batch_id,\n        v_request.vehicle_brand,\n        v_brand_key,\n        v_request.vehicle_model,\n        v_model_key,\n        nullif(trim(v_rule_structure), ''),\n        v_rule_structure_key,\n        case when v_version_key <> '' then v_request.vehicle_version else null end,\n        v_version_key,\n        v_year_from,\n        v_year_to,\n        p_status,\n        p_rule_scope,\n        case when p_rule_scope in ('generation', 'chassis_platform') then true else false end,\n        nullif(trim(p_public_notes), ''),\n        nullif(trim(p_internal_notes), ''),\n        nullif(trim(p_internal_notes), ''),\n        nullif(trim(p_installation_conditions), ''),\n        p_confidence_level,\n        nullif(trim(p_reviewed_by), ''),\n        now(),\n        p_request_id,\n        nullif(trim(p_reviewed_by), ''),\n        1,\n        true\n      ) returning id into v_rule_id;\n\n      insert into public.compatibility_rule_audit (\n        rule_id, request_id, decision_batch_id, action,\n        new_status, actor, new_response, change_reason,\n        new_rule_version, details\n      ) values (\n        v_rule_id, p_request_id, v_batch_id, 'created',\n        p_status, nullif(trim(p_reviewed_by), ''),\n        jsonb_build_object(\n          'status', p_status,\n          'active', true,\n          'scope', p_rule_scope,\n          'year_from', v_year_from,\n          'year_to', v_year_to,\n          'public_notes', nullif(trim(p_public_notes), ''),\n          'internal_notes', nullif(trim(p_internal_notes), ''),\n          'installation_conditions', nullif(trim(p_installation_conditions), ''),\n          'confidence_level', p_confidence_level,\n          'product_id', v_product.id\n        ),\n        coalesce(nullif(trim(p_change_reason), ''), 'Nova confirmação administrativa'),\n        1,\n        jsonb_build_object('product_id', v_product.id, 'product_sku', v_product.sku)\n      );\n    end if;\n\n    v_rule_ids := array_append(v_rule_ids, v_rule_id);\n    if v_primary_rule_id is null then v_primary_rule_id := v_rule_id; end if;\n  end loop;\n\n  -- Atualiza todas as consultas pendentes realmente equivalentes ao escopo.\n  update public.compatibility_requests as candidate\n  set\n    status = p_status,\n    recommended_product_skus = case\n      when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n      else array[]::text[]\n    end,\n    admin_notes = case\n      when candidate.id = p_request_id then nullif(trim(p_internal_notes), '')\n      else candidate.admin_notes\n    end,\n    reviewed_by = nullif(trim(p_reviewed_by), ''),\n    reviewed_at = now(),\n    matched_rule_id = v_primary_rule_id,\n    decision_batch_id = v_batch_id,\n    decision_source = case\n      when candidate.id = p_request_id then 'manual_review'\n      else 'learned_rule'\n    end,\n    conflict_detected = false,\n    vehicle_profile_id = v_profile_id,\n    vehicle_normalized_key = public.ohc_build_vehicle_normalized_key(\n      candidate.vehicle_brand,\n      candidate.vehicle_model,\n      candidate.vehicle_year,\n      candidate.vehicle_version,\n      candidate.vehicle_generation,\n      coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis),\n      candidate.vehicle_motorization\n    ),\n    result_presented = jsonb_build_object(\n      'status', p_status,\n      'recommended_product_skus', case\n        when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n        else array[]::text[]\n      end,\n      'public_notes', nullif(trim(p_public_notes), ''),\n      'installation_conditions', nullif(trim(p_installation_conditions), ''),\n      'matched_rule_id', v_primary_rule_id,\n      'decision_batch_id', v_batch_id,\n      'saved_as_rule', true\n    ),\n    updated_at = now()\n  where candidate.status = 'analise_necessaria'\n    and public.ohc_normalize_vehicle_brand(candidate.vehicle_brand) = v_brand_key\n    and candidate.vehicle_year between v_year_from and v_year_to\n    and case p_rule_scope\n      when 'exact_vehicle_version' then\n        public.ohc_normalize_vehicle_model_v2(\n          candidate.vehicle_brand,\n          candidate.vehicle_model,\n          candidate.vehicle_year,\n          candidate.vehicle_generation,\n          coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis)\n        ) = v_model_key\n        and candidate.vehicle_year = v_request.vehicle_year\n        and public.ohc_normalize_compatibility_text(candidate.vehicle_version) = v_version_key\n        and public.ohc_normalize_compatibility_text(coalesce(\n          candidate.vehicle_chassis_platform,\n          candidate.generation_chassis\n        )) = v_chassis_key\n      when 'model_year_range' then\n        public.ohc_normalize_vehicle_model_v2(\n          candidate.vehicle_brand,\n          candidate.vehicle_model,\n          candidate.vehicle_year,\n          candidate.vehicle_generation,\n          coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis)\n        ) = v_model_key\n        and (\n          v_chassis_key = ''\n          or public.ohc_normalize_compatibility_text(coalesce(\n            candidate.vehicle_chassis_platform,\n            candidate.generation_chassis\n          )) = v_chassis_key\n        )\n      when 'generation' then\n        public.ohc_normalize_vehicle_model_v2(\n          candidate.vehicle_brand,\n          candidate.vehicle_model,\n          candidate.vehicle_year,\n          candidate.vehicle_generation,\n          coalesce(candidate.vehicle_chassis_platform, candidate.generation_chassis)\n        ) = v_model_key\n        and public.ohc_normalize_compatibility_text(coalesce(\n          candidate.vehicle_generation,\n          candidate.generation_chassis\n        )) = v_generation_key\n      when 'chassis_platform' then\n        public.ohc_normalize_compatibility_text(coalesce(\n          candidate.vehicle_chassis_platform,\n          candidate.generation_chassis\n        )) = v_chassis_key\n      else false\n    end;\n\n  get diagnostics v_resolved_count = row_count;\n\n  -- Caso a solicitação original já não estivesse pendente, garante a gravação.\n  update public.compatibility_requests\n  set\n    status = p_status,\n    recommended_product_skus = case\n      when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n      else array[]::text[]\n    end,\n    admin_notes = nullif(trim(p_internal_notes), ''),\n    reviewed_by = nullif(trim(p_reviewed_by), ''),\n    reviewed_at = now(),\n    matched_rule_id = v_primary_rule_id,\n    decision_batch_id = v_batch_id,\n    decision_source = 'manual_review',\n    conflict_detected = false,\n    vehicle_profile_id = v_profile_id,\n    vehicle_normalized_key = public.ohc_build_vehicle_normalized_key(\n      v_request.vehicle_brand,\n      v_request.vehicle_model,\n      v_request.vehicle_year,\n      v_request.vehicle_version,\n      v_request.vehicle_generation,\n      coalesce(v_request.vehicle_chassis_platform, v_request.generation_chassis),\n      v_request.vehicle_motorization\n    ),\n    result_presented = jsonb_build_object(\n      'status', p_status,\n      'recommended_product_skus', case\n        when p_status in ('compativel', 'compativel_com_condicoes') then v_product_skus\n        else array[]::text[]\n      end,\n      'public_notes', nullif(trim(p_public_notes), ''),\n      'installation_conditions', nullif(trim(p_installation_conditions), ''),\n      'matched_rule_id', v_primary_rule_id,\n      'decision_batch_id', v_batch_id,\n      'saved_as_rule', true\n    ),\n    updated_at = now()\n  where id = p_request_id;\n\n  return jsonb_build_object(\n    'ok', true,\n    'rule_saved', true,\n    'status', p_status,\n    'decision_batch_id', v_batch_id,\n    'rule_ids', to_jsonb(v_rule_ids),\n    'product_ids', to_jsonb(v_product_ids),\n    'product_skus', to_jsonb(v_product_skus),\n    'resolved_equivalent_requests', greatest(v_resolved_count - 1, 0),\n    'replaced_conflicts', cardinality(v_conflict_ids),\n    'year_from', v_year_from,\n    'year_to', v_year_to,\n    'scope', p_rule_scope\n  );\nend;\n$function$\n"},{"proname":"ohc_deactivate_compatibility_rule","definition":"CREATE OR REPLACE FUNCTION public.ohc_deactivate_compatibility_rule(p_rule_id uuid, p_actor text, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_rule public.compatibility_rules%rowtype;\nbegin\n  select * into v_rule\n  from public.compatibility_rules\n  where id = p_rule_id\n  for update;\n\n  if not found then\n    return jsonb_build_object('ok', false, 'error', 'rule_not_found');\n  end if;\n\n  if not v_rule.active then\n    return jsonb_build_object('ok', true, 'already_inactive', true, 'rule_id', v_rule.id);\n  end if;\n\n  update public.compatibility_rules\n  set active = false, rule_version = rule_version + 1, updated_at = now()\n  where id = v_rule.id;\n\n  insert into public.compatibility_rule_audit (\n    rule_id,\n    request_id,\n    decision_batch_id,\n    action,\n    previous_status,\n    new_status,\n    actor,\n    previous_response,\n    new_response,\n    change_reason,\n    previous_rule_version,\n    new_rule_version,\n    details\n  ) values (\n    v_rule.id,\n    v_rule.evidence_request_id,\n    v_rule.decision_batch_id,\n    'deactivated',\n    v_rule.status,\n    v_rule.status,\n    nullif(trim(p_actor), ''),\n    jsonb_build_object('active', true, 'status', v_rule.status, 'scope', v_rule.rule_scope),\n    jsonb_build_object('active', false, 'status', v_rule.status, 'scope', v_rule.rule_scope),\n    coalesce(nullif(trim(p_reason), ''), 'Desativação administrativa'),\n    v_rule.rule_version,\n    v_rule.rule_version + 1,\n    jsonb_build_object('product_id', v_rule.product_id, 'product_sku', v_rule.product_sku)\n  );\n\n  return jsonb_build_object(\n    'ok', true,\n    'rule_id', v_rule.id,\n    'active', false,\n    'rule_version', v_rule.rule_version + 1\n  );\nend;\n$function$\n"},{"proname":"ohc_attach_bmw_compatibility_suggestions","definition":"CREATE OR REPLACE FUNCTION public.ohc_attach_bmw_compatibility_suggestions()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  if coalesce(btrim(new.admin_notes), '') = '' then\n    new.admin_notes := public.ohc_bmw_compatibility_suggestions(\n      new.vehicle_brand,\n      new.vehicle_model,\n      new.generation_chassis\n    );\n  end if;\n  return new;\nend;\n$function$\n"},{"proname":"ohc_bmw_compatibility_suggestions","definition":"CREATE OR REPLACE FUNCTION public.ohc_bmw_compatibility_suggestions(vehicle_brand text, vehicle_model text, generation_chassis text)\n RETURNS text\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  search_text text := upper(\n    coalesce(vehicle_brand, '') || ' ' ||\n    coalesce(vehicle_model, '') || ' ' ||\n    coalesce(generation_chassis, '')\n  );\n  has_chassis boolean;\n  suggestions text;\nbegin\n  if upper(coalesce(vehicle_brand, '')) not like '%BMW%'\n     and search_text not like '%BMW%' then\n    return null;\n  end if;\n\n  has_chassis := search_text ~ '(^|[^A-Z0-9])[EFG][0-9]{2}([^A-Z0-9]|$)';\n\n  with candidates as (\n    select\n      p.sku,\n      p.nome_produto,\n      p.tipo_cubo_adaptador,\n      exists (\n        select 1\n        from regexp_matches(\n          upper(coalesce(p.geracao_chassi, '')),\n          '([EFG][0-9]{2})',\n          'g'\n        ) as chassis_code\n        where search_text ~ (\n          '(^|[^A-Z0-9])' || chassis_code[1] || '([^A-Z0-9]|$)'\n        )\n      ) as chassis_match,\n      case\n        when search_text ~ '(^|[^A-Z0-9])M3([^A-Z0-9]|$)'\n             and upper(coalesce(p.nome_produto, '')) like '%M3%' then 25\n        when search_text ~ '(^|[^A-Z0-9])M5([^A-Z0-9]|$)'\n             and upper(coalesce(p.nome_produto, '')) like '%M5%' then 25\n        else 0\n      end as model_score\n    from public.catalog_products p\n    where p.ativo is true\n      and upper(coalesce(p.marca, '')) = 'BMW'\n      and upper(coalesce(p.tipo_produto, '')) like '%VOLANTE%'\n      and coalesce(p.sku, '') <> ''\n      and coalesce(p.compatibilidade, '') <> ''\n  ),\n  ranked as (\n    select *, (case when chassis_match then 100 else 0 end) + model_score as score\n    from candidates\n    where (has_chassis and chassis_match)\n       or (not has_chassis and model_score > 0)\n  ),\n  top_matches as (\n    select *\n    from ranked\n    order by score desc, sku\n    limit 12\n  )\n  select string_agg(\n    'SKU ' || sku || ' — ' || nome_produto ||\n    ' — ' || coalesce(tipo_cubo_adaptador, 'Plataforma a confirmar'),\n    E'\\n'\n    order by score desc, sku\n  )\n  into suggestions\n  from top_matches;\n\n  if suggestions is null then\n    return 'Base BMW OHC: nenhum volante foi associado automaticamente. Confirmar manualmente modelo, geração/chassi e airbag.';\n  end if;\n\n  return\n    'Base BMW OHC — sugestões automáticas (confirmar manualmente antes de aprovar):' ||\n    E'\\n' || suggestions;\nend;\n$function$\n"},{"proname":"ohc_normalize_compatibility_text","definition":"CREATE OR REPLACE FUNCTION public.ohc_normalize_compatibility_text(value text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO ''\nAS $function$\n  select trim(\n    regexp_replace(\n      translate(\n        lower(coalesce(value, '')),\n        'áàâãäéèêëíìîïóòôõöúùûüç',\n        'aaaaaeeeeiiiiooooouuuuc'\n      ),\n      '[^a-z0-9]+',\n      ' ',\n      'g'\n    )\n  );\n$function$\n"},{"proname":"ohc_resolve_compatibility","definition":"CREATE OR REPLACE FUNCTION public.ohc_resolve_compatibility(p_product_sku text, p_vehicle_brand text, p_vehicle_model text, p_vehicle_year integer, p_generation_chassis text, p_vehicle_version text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_product_key text := public.ohc_normalize_compatibility_text(p_product_sku);\n  v_brand_key text := public.ohc_normalize_compatibility_text(p_vehicle_brand);\n  v_model_key text := public.ohc_normalize_compatibility_text(p_vehicle_model);\n  v_generation_key text := public.ohc_normalize_compatibility_text(p_generation_chassis);\n  v_version_key text := public.ohc_normalize_compatibility_text(p_vehicle_version);\n  v_candidate_count bigint := 0;\n  v_status_count bigint := 0;\n  v_rule_id uuid;\n  v_status text;\nbegin\n  if v_product_key = '' or v_brand_key = '' or v_model_key = '' or\n     p_vehicle_year is null or p_vehicle_year < 1950 or p_vehicle_year > 2100 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', false,\n      'reason', 'invalid_input'\n    );\n  end if;\n\n  with candidates as (\n    select\n      rule.id,\n      rule.status,\n      rule.updated_at,\n      (case\n        when rule.generation_key = v_generation_key and v_generation_key <> '' then 4\n        when rule.generation_key = '' then 1\n        else 0\n      end) +\n      (case\n        when rule.version_key = v_version_key and v_version_key <> '' then 2\n        when rule.version_key = '' then 1\n        else 0\n      end) as specificity\n    from public.compatibility_rules as rule\n    where rule.active\n      and rule.product_sku_key = v_product_key\n      and rule.vehicle_brand_key = v_brand_key\n      and rule.vehicle_model_key = v_model_key\n      and p_vehicle_year between rule.year_from and rule.year_to\n      and (rule.generation_key = '' or rule.generation_key = v_generation_key)\n      and (rule.version_key = '' or rule.version_key = v_version_key)\n  ), best as (\n    select *\n    from candidates\n    where specificity = (select max(specificity) from candidates)\n  )\n  select\n    count(*),\n    count(distinct status),\n    (array_agg(id order by updated_at desc))[1],\n    (array_agg(status order by updated_at desc))[1]\n  into v_candidate_count, v_status_count, v_rule_id, v_status\n  from best;\n\n  if v_candidate_count = 0 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', false,\n      'reason', 'no_rule'\n    );\n  end if;\n\n  if v_status_count > 1 then\n    return jsonb_build_object(\n      'matched', false,\n      'conflict', true,\n      'reason', 'conflicting_rules',\n      'candidate_count', v_candidate_count\n    );\n  end if;\n\n  return jsonb_build_object(\n    'matched', true,\n    'conflict', false,\n    'rule_id', v_rule_id,\n    'status', v_status,\n    'candidate_count', v_candidate_count\n  );\nend;\n$function$\n"}]}
diff --git a/tests/frontend.test.ts b/tests/frontend.test.ts
new file mode 100644
index 0000000..e7c0d1e
--- /dev/null
+++ b/tests/frontend.test.ts
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { readFileSync, existsSync } from 'node:fs';
+import { compatibilityMessage } from '../src/lib/compatibility';
+import { internalDestination } from '../src/lib/navigation';
+import { safeEvent } from '../src/lib/telemetry';
+import { PRODUCTS } from '../src/lib/products';
+test('navigation rejects external, protocol-relative, control and unregistered destinations', () => {
+  for (const path of ['https://evil.invalid', '//evil.invalid', '/\\evil.invalid', '/admin', '/api/admin', '/%2e%2e/admin', '/catalogo\n']) assert.equal(internalDestination(path, 'https://ohc.invalid'), null);
+  assert.equal(internalDestination('/produto?sku=test#foto', 'https://ohc.invalid'), '/produto?sku=test#foto');
+});
+test('compatibility keeps the actual catalog SKU and business message', () => {
+  const text = compatibilityMessage({marca:'Marca fictícia',modelo:'Teste',ano:'2025',acc:'Não',sku:PRODUCTS[0].sku},2026);
+  assert.match(text, /confirmar a compatibilidade/); assert.ok(text.includes(PRODUCTS[0].sku)); assert.match(text,/3 fotos/);
+});
+test('compatibility rejects invalid types, years, unexpected privileges and oversized text', () => {
+  const base={marca:'Teste',modelo:'Fictício',ano:'2025'};
+  for(const extra of [{ano:'2028'},{ano:'1949'},{ano:'NaN'},{marca:42},{modelo:''},{obs:'a'.repeat(1001)},{role:'admin'},{sku:'not-a-real-sku'},{acc:'root'}]) assert.throws(()=>compatibilityMessage({...base,...extra},2026));
+});
+test('telemetry drops PII, tokens, queries, request bodies and original messages', () => {
+  const event = {event_id:'synthetic-event',timestamp:1,user:{email:'ficticio@example.invalid'},request:{data:'private'},breadcrumbs:[{message:'private'}],tags:{component:'app',secret:'private'},exception:{values:[{value:'private',stacktrace:{frames:[{filename:'https://ohc.invalid/assets/app-123.js?token=private',lineno:3},{filename:'https://external.invalid/path/private'}]}}]}};
+  const clean=safeEvent(event); const json=JSON.stringify(clean);
+  assert.ok(!json.includes('private')); assert.ok(!json.includes('example.invalid')); assert.equal(clean.exception.values[0].stacktrace.frames.length,1); assert.equal(clean.tags.component,'app');
+});
+test('65 original products retain resolvable local original images', () => {
+  assert.equal(PRODUCTS.length,65);
+  const raw=readFileSync('src/data/products.json','utf8');
+  for(const path of raw.match(/\/(?:img|imagens)\/[^"\s]+/g) ?? []) assert.ok(existsSync('public'+path),path);
+  const glb=readFileSync('public/models/steering-wheel-original.glb'); assert.equal(glb.toString('ascii',0,4),'glTF');
+});
+test('deployment headers protect content without swallowing backend or model paths', () => {
+  const c=JSON.parse(readFileSync('vercel.json','utf8'));
+  const headers=Object.fromEntries(c.headers[0].headers.map((h:{key:string;value:string})=>[h.key,h.value]));
+  assert.match(headers['Content-Security-Policy'],/frame-ancestors 'none'/);assert.match(headers['Content-Security-Policy'],/script-src 'self';/);assert.equal(headers['X-Content-Type-Options'],'nosniff');
+  assert.ok(!c.rewrites.some((r:{source:string})=>r.source==='/(.*)' || r.source==='/:path*'));
+});
diff --git a/tests/telemetry-integration.test.ts b/tests/telemetry-integration.test.ts
new file mode 100644
index 0000000..5b4e7d6
--- /dev/null
+++ b/tests/telemetry-integration.test.ts
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { BrowserClient } from '@sentry/react';
+import { safeEvent } from '../src/lib/telemetry';
+test('actual Sentry client captures error through privacy filter into a local fake transport',async()=>{
+ const sent:unknown[]=[];
+ const client=new BrowserClient({dsn:'https://publictest@o0.ingest.sentry.io/1',integrations:[],sendDefaultPii:false,beforeSend:event=>safeEvent(event),transport:()=>({send:envelope=>{sent.push(envelope);return Promise.resolve({statusCode:200});},flush:()=>Promise.resolve(true)})});
+ client.captureException(new Error('private-person@example.invalid token=private-test-token'));
+ assert.equal(await client.flush(2000),true);assert.equal(sent.length,1);
+ const data=JSON.stringify(sent);assert.ok(!data.includes('private-person'));assert.ok(!data.includes('private-test-token'));assert.ok(data.includes('Application error'));
+ await client.close();
+});
diff --git a/tsconfig.json b/tsconfig.json
index ef56e37..a52c991 100644
