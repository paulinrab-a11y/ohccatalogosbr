 {
   "compilerOptions": {
-    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
-    "jsx": "react-jsx", "strict": false, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
-    "noEmit": true, "allowJs": true, "esModuleInterop": true
+    "target": "ES2020",
+    "lib": [
